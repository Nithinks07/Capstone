# Anthropic API key — required. Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...


ANTHROPIC_WORKSPACE_ID=wrkspc...

# Optional: override the Reasoner model (default: claude-sonnet-4-6)
# REASONER_MODEL_ID=claude-sonnet-4-6

# Optional: override the LLM-as-judge model (default: claude-haiku-4-5-20251001)
# JUDGE_MODEL_ID=claude-haiku-4-5-20251001

# Optional: path for the pipeline trace log (default: pipeline.log in cwd)
# PIPELINE_LOG=pipeline.log

# Optional: SQLite path for persistent rate-limit store (default: rate_limits.db in cwd)
# RATE_LIMIT_DB=rate_limits.db
